{
  "name": "fastproduct-backend",
  "private": true,
  "description": "Supabase (migrations + Edge). Scripts npm facilitam o mesmo type-check do CI sem instalar Deno globalmente.",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "deno": "2.9.6",
    "supabase": "2.120.0"
  },
  "scripts": {
    "check": "npm run check:edge",
    "typecheck": "npm run check:edge",
    "check:edge": "deno check supabase/functions/sync-outbox/index.ts && deno check supabase/functions/validar-gerente/index.ts && deno check --config supabase/functions/fiscal-worker/deno.json supabase/functions/fiscal-worker/index.ts",
    "check:venda-finance-context-retirement": "node supabase/scripts/validate-venda-finance-context-retirement.mjs",
    "check:types-drift": "node scripts/check-types-drift.mjs",
    "smoke:rls-rest": "node scripts/p0-rls-rest-smoke.mjs",
    "test:rls-policies": "node scripts/test-rls-policies.mjs",
    "test:rls-scope": "node scripts/test-rls-scope.mjs",
    "assert:descontos-venda-rls-loja": "node scripts/assert-descontos-venda-rls-loja.mjs",
    "check:phase3-2": "node supabase/scripts/validate-phase3-2.mjs",
    "ci:e2e-readiness": "node scripts/ci-e2e-readiness-check.mjs",
    "test:financial": "node scripts/run-financial-tests.mjs",
    "test:financial-concurrency": "node scripts/test-commission-concurrency.mjs",
    "test:financial-concurrency:nfe": "node scripts/test-nfe-conferencia-concurrency.mjs",
    "test:migration-status": "node --test scripts/p0-migration-status.test.mjs",
    "test:venda-finance-context-retirement": "node --test supabase/scripts/verify-venda-finance-context-catalog.test.mjs",
    "test:financeiro-loja": "node scripts/test-financeiro-loja.mjs",
    "test:fiscal-rpc-authz": "node scripts/fiscal-rpc-loja-authz.test.mjs",
    "test:fiscal-cancelamento-categoria": "node scripts/fiscal-cancelamento-categoria.test.mjs",
    "test:hardening-residual": "node scripts/hardening-rls-search-path-residual.test.mjs",
    "test:go-live-01-isolamento": "node scripts/go-live-01-isolamento.test.mjs",
    "test:backup-restore-isolado": "node scripts/backup-restore-isolado.test.mjs",
    "test:fiscal-p0-pre-req": "node scripts/fiscal-p0-pre-req.test.mjs",
    "test:fiscal-drill-plano": "node scripts/fiscal-drill-plano.test.mjs",
    "test:backup-age": "node scripts/backup-age-postgres.test.mjs",
    "test:pdv-caixa-financeiro": "node scripts/test-pdv-caixa-financeiro-fluxo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "@vercel/analytics": "^2.0.1"
  }
}
