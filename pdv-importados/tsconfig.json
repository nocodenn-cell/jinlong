{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es2021"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      "@shared-core/*": [
        "../shared-core/*"
      ],
      "@/shared/*": [
        "./shared/*"
      ],
      "@/i18n/*": [
        "./src/lib/i18n/*"
      ],
      "@/idioma/*": [
        "./src/lib/idioma/*"
      ]
    },
    "target": "ES2022"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test-helpers.ts",
    "**/*.test-helpers.tsx",
    "**/*.mock.ts",
    "**/*.mock.tsx",
    "**/*.fixture.ts",
    "**/*.fixture.tsx",
    "**/*.factory.ts",
    "**/*.factory.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/__tests__/**",
    "**/__mocks__/**",
    "e2e",
    "e2e/**",
    "stories/**",
    "tests/**",
    ".storybook/**",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}