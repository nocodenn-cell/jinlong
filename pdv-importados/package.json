    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.99.3",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.0.0",
    "bwip-js": "^4.10.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.14",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "nanoid": "^3.3.8",
    "next": "^15.5.15",
    "picocolors": "^1.1.1",
    "postcss": "^8.4.38",
    "react": "19.2.5",
    "react-dom": "19.2.8",
    "react-is": "^19.2.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "source-map-js": "^1.2.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "ws": "^8.20.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@storybook/addon-backgrounds": "^8.6.14",
    "@storybook/addon-controls": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-viewport": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test-runner": "^0.22.0",
    "@types/jspdf": "^1.3.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "jscpd": "^4.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
