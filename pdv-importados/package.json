{
  "name": "pdv-importados",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:integration:cancelamento": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --exclude \"app/caixa/**/*.test.ts\" --exclude \"app/caixa/**/*.integration.test.ts\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:hydration": "playwright test e2e/hydration.spec.ts",
    "test:e2e:h": "playwright test e2e/hydration.spec.ts",
    "test:e2e:critical": "node scripts/e2e-critical-pipeline.mjs",
    "test:e2e:post-deploy-smoke": "node scripts/e2e-post-deploy-smoke.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "env:check": "node scripts/check-env.mjs",
    "smoke:http": "node scripts/smoke-routes.mjs",
    "test:cors:validar-gerente": "node scripts/test-cors-validar-gerente.mjs",
    "seed:dev-users": "node scripts/seed-dev-users.mjs",
    "seed:demo-fluxo": "node scripts/seed-demo-fluxo-staging.mjs",
    "test:demo-fluxo": "vitest run lib/pdv ../shared-core/src/pdv/invariants",
    "check:pdv-invariant-boundary": "node scripts/check-pdv-invariant-boundary.mjs",
    "check:entity-ssot": "node scripts/check-entity-ssot-boundary.mjs",
    "check:golive": "npm run check:entity-ssot && vitest run app/admin/implantacao/homologacaoDados.test.ts app/admin/implantacao/implantacaoCatalog.test.ts tests/p0-venda-homologacao.matrix.test.ts tests/p0-roteiro-operacional.matrix.test.ts",
    "check:caixa-pre-producao": "node scripts/check-caixa-pre-producao.mjs",
    "check:ds-burndown": "node scripts/ds-legacy-burndown.mjs",
    "check:ds-coverage": "node scripts/ds-coverage.mjs",
    "guard:design-system": "node ../scripts/design-guard.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook"
  },
  "dependencies": {
    "@fastproduct/shared-core": "0.1.0",
    "@fontsource/noto-serif-sc": "^5.2.9",
