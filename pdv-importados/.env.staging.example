# =============================================================================
# Homologação / capacidade (STG-01) — NÃO é .env.local
# Copie para .env.capacity (gitignored) e exporte no shell.
# Nunca sobrescreva .env.local sem autorização.
# Orçamento: R$ 0 — Trilha F (Free remoto) ou Trilha L (Docker local).
# =============================================================================

# --- Trilha F (Free remoto) ---
# CAPACITY_ENV=staging
# CAPACITY_ALLOWED_PROJECT_REF=COLE_REF_STAGING_AQUI
# GATE_STAGING_PROJECT_REF=COLE_REF_STAGING_AQUI
# CAPACITY_BLOCKED_PROJECT_REFS=COLE_REF_PRODUCAO_AQUI
# CAPACITY_SUPABASE_URL=https://COLE_REF_STAGING_AQUI.supabase.co
# CAPACITY_ANON_KEY=COLE_AQUI
# CAPACITY_SERVICE_ROLE_KEY=COLE_AQUI

# --- Trilha L (Docker local isolado — ports do stack capacidade, NÃO o DEV) ---
CAPACITY_ENV=local
# CAPACITY_SUPABASE_URL=http://127.0.0.1:54421
# CAPACITY_ANON_KEY=COLE_AQUI_DO_STACK_CAPACIDADE
# CAPACITY_SERVICE_ROLE_KEY=COLE_AQUI_DO_STACK_CAPACIDADE
# Local não exige ALLOWED/BLOCKED refs; remoto Free exige ambos.

# Senha dos usuários sintéticos @capacity.staging.invalid (≥12 chars)
CAPACITY_SEED_PASSWORD=COLE_SENHA_FORTE_AQUI

# Escala do seed — custo zero: 1, depois 5, depois 10
CAPACITY_LOJAS=1
CAPACITY_CAIXAS_POR_LOJA=2
CAPACITY_ESTOQUE_QTD=10000

# Confirmações explícitas (scripts recusam sem isto)
# CAPACITY_CONFIRM_SEED=yes
# CAPACITY_CONFIRM_RESET=yes
# CAPACITY_CONFIRM_DB_PUSH=yes

# k6 (mesmo alvo do CAPACITY_SUPABASE_URL)
# K6_SUPABASE_URL=http://127.0.0.1:54421
# K6_ANON_KEY=COLE_AQUI
