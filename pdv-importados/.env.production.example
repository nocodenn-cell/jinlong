# Variáveis de ambiente para produção (Vercel)
# ⚠️ NUNCA commitar credenciais reais neste arquivo
# Configure as variáveis via Vercel Dashboard: Settings → Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Aplicação
NEXT_PUBLIC_APP_NAME=PDV Importados
NEXT_PUBLIC_DEFAULT_LANG=pt
NEXT_PUBLIC_ADMIN_CHINESE_UI=false
NEXT_PUBLIC_IDLE_LOGOUT_MINUTES=0
NEXT_PUBLIC_DEBUG_MODE=false

# Features
USE_UNIFIED_SALES_FLOW=true
STRICT_MANAGER_DISCOUNT_AUTH=true
