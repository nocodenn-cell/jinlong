# Público (browser) — Dashboard Supabase → Project Settings → API
#
# ATENÇÃO: NEXT_PUBLIC_SUPABASE_URL deve ser a URL HTTPS do projeto (.supabase.co),
# NÃO o JWT da anon key nem a service_role (erro comum).
#
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Cole a anon/public key do Dashboard → Settings → API (não use service_role aqui).
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE_AQUI_SUA_ANON_PUBLIC_KEY

# Apenas server-side (Server Actions, Route Handlers, scripts Node no Next). NÃO use no cliente.
# Não commite valores reais; use .env.local (ignorado pelo git).
# Obrigatório para: npm run seed:dev-users (ver docs/SEED_DEV_E2E.md)
# Nunca coloque esta chave em pdv-local/.env (desktop); o Tauri usa só SYNC_* + Edge.
# SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SUA_SERVICE_ROLE_KEY


# Senha compartilhada pelos usuários de teste criados pelo seed (dev/E2E).
# Pode reutilizar PLAYWRIGHT_TEST_PASSWORD em vez desta.
# SEED_DEV_PASSWORD=
# SEED_GERENTE_EMAIL=e2e-gerente@localhost.test
# SEED_OPERADOR_EMAIL=e2e-operador@localhost.test

NEXT_PUBLIC_APP_NAME=PDV Importados
NEXT_PUBLIC_DEFAULT_LANG=pt

# Relatórios /gerente/relatorios — fuso IANA (ex. America/Sao_Paulo, UTC). Só servidor; se definida, prevalece sobre public.relatorio_settings.
# RELATORIO_TIMEZONE=America/Sao_Paulo
