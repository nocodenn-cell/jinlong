# ==============================================================================
# PDV-IMPORTADOS - ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO (.env.example)
# Instruções: Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o arquivo .env.local com segredos reais no controle de versão.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE - CONFIGURAÇÕES DE API (OBRIGATÓRIO)
# Encontre em: Dashboard Supabase -> Project Settings -> API
# ------------------------------------------------------------------------------

# URL HTTPS do projeto (ex.: https://xyz123.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Anon/Public Key (Segura para uso no Client-side/Browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE_AQUI_SUA_ANON_PUBLIC_KEY

# Service Role Key (APENAS SERVER-SIDE).
# Obrigatório para scripts de seed e bypass de RLS em rotas administrativas.
# NUNCA exponha esta chave no front-end ou em builds desktop (Tauri).
# SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SUA_SERVICE_ROLE_KEY

# Edge Function validar-gerente (secrets no projeto Supabase, NÃO neste ficheiro):
# VALIDAR_GERENTE_CORS_STRICT=true
# VALIDAR_GERENTE_ALLOWED_ORIGINS=https://seu-dominio,http://localhost:3000
# Ver pdv-importados/scripts/supabase-edge-secrets.example.ps1

# ------------------------------------------------------------------------------
# 2. SEGURANÇA E SESSÃO
# ------------------------------------------------------------------------------

# Logout automático por inatividade (minutos). 0 ou vazio = desativado.
# Recomendado para demo: 0 (ou 60 para simular segurança real).
NEXT_PUBLIC_IDLE_LOGOUT_MINUTES=0

# ------------------------------------------------------------------------------
# 3. IDENTIFICAÇÃO E LOCALIZAÇÃO
# ------------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=PDV Importados
NEXT_PUBLIC_DEFAULT_LANG=pt

# Painel /admin: textos bilíngues (中文 + PT) e fonte Noto Sans SC. false = só português e layout neutro (menos peso de fonte).
NEXT_PUBLIC_ADMIN_CHINESE_UI=true

# Fuso horário para processamento de relatórios no servidor (IANA timezone).
# Ex.: America/Sao_Paulo, UTC.
RELATORIO_TIMEZONE=America/Sao_Paulo

# Meta diária do dashboard do gerente (opcional), com prioridade:
# gerente > loja > default.
# Exemplo de JSON:
# {"default":2000,"lojas":{"a0000001-0000-4000-8000-000000000001":3500},"gerentes":{"00000000-0000-0000-0000-000000000123":5000}}
# GERENTE_DASHBOARD_META_DIA_JSON={"default":2000}

# Identificador opcional do Terminal (PDV 1, PDV 2, etc).
# NEXT_PUBLIC_TERMINAL_ID=MATRIZ-CAIXA-01

# ------------------------------------------------------------------------------
# 4. MÓDULO FISCAL (EDGE FUNCTIONS)
# URL: https://<ref>.supabase.co/functions/v1/fiscal-worker
# ------------------------------------------------------------------------------

# Endpoint da Edge Function que processa a fila fiscal.
FISCAL_WORKER_ENDPOINT=https://SEU_PROJECT_REF.supabase.co/functions/v1/fiscal-worker

# Segredo compartilhado via Header X-FISCAL-WORKER-KEY (Deve ser forte).
FISCAL_WORKER_KEY=COLE_UM_SEGREDO_FORTE_AQUI

# Enfileira documento fiscal automaticamente ao finalizar venda no caixa web.
# Recomendado: true em homologação/produção (mantendo provider em "mock" até concluir Focus).
AUTO_ENQUEUE_FISCAL_ON_SALE=true

# Tipo padrão de documento para enfileiramento pós-venda: NFC_E_STUB | NFCE | NFE
# Enquanto a integração real não estiver concluída, mantenha NFC_E_STUB.
FISCAL_DEFAULT_DOC_TYPE=NFC_E_STUB

# ------------------------------------------------------------------------------
# 5. FLAGS DE FUNCIONALIDADE (VENDAS / CAIXA)
# ------------------------------------------------------------------------------

# Produção (recomendado): alinhar com os secrets das Edge Functions no mesmo projeto Supabase.
# Desenvolvimento local (opcional): comente ou defina como false se ainda estiver migrando.
USE_UNIFIED_SALES_FLOW=true
STRICT_MANAGER_DISCOUNT_AUTH=true

# Layout visual do caixa web (opcional). `classic` = top bar azul + fundo claro (mockup PDV).
# Homologação / staging (ex.: fastproduct-staging): defina na Vercel **Environment Variables** do ambiente
# de Preview ou de “Staging” como `NEXT_PUBLIC_CAIXA_PDV_LAYOUT=classic` para o cliente validar o visual.
# A página `/caixa` com layout classic pode mostrar um banner de pré-visualização (ver `NEXT_PUBLIC_CAIXA_PDV_LAYOUT_PREVIEW_BANNER` abaixo). Em produção deixe comentado até decisão explícita.
# NEXT_PUBLIC_CAIXA_PDV_LAYOUT=classic

# Banner informativo «PDV clássico» acima da grelha (só quando layout=classic).
# Produção: omita ou use 0 para ocultar. Homologação: 1 para exibir. Desenvolvimento (next dev): visível por omissão; use 0 para ocultar.
# NEXT_PUBLIC_CAIXA_PDV_LAYOUT_PREVIEW_BANNER=1
# NEXT_PUBLIC_CAIXA_PDV_LAYOUT_PREVIEW_BANNER=0

# Fluxo demo E2E em /demo-fluxo (staging/preview). Produção: omitir ou false.
# NEXT_PUBLIC_ENABLE_DEMO_FLUXO=true

# Ativa logs detalhados de depuração no console do navegador (apenas para DEV).
NEXT_PUBLIC_DEBUG_MODE=false

# Telemetria do pipeline de bip (caixa): probabilidade 0–1 por evento enviada a /api/caixa/scan-telemetry (sessão Supabase).
# Requer migrações 095 + 096 + 097 (`caixa_scan_telemetry_events`). Planear retenção/partição e dashboards p95 antes de subir sample em produção.
NEXT_PUBLIC_CAIXA_SCAN_TELEMETRY_SAMPLE_RATE=0

# Referência USD→BRL exibida no caixa (Frankfurter). Se a API falhar, pode usar fallback numérico (sem segredo).
# CAMBIO_USD_BRL_FALLBACK=5.55
# NEXT_PUBLIC_CAMBIO_USD_BRL_FALLBACK=5.55

# ------------------------------------------------------------------------------
# 6. CONFIGURAÇÕES DE DESENVOLVIMENTO (SEED / E2E)
# ------------------------------------------------------------------------------

# Habilita rota /demo-fluxo (staging/homologação apenas).
# NEXT_PUBLIC_ENABLE_DEMO_FLUXO=true

# Promove warning→error na avaliação PDV (não altera mode). Staging enforcement.
# PDV_INVARIANT_ASSERT=1

# Janela de deploy R1 catálogo: bloqueia import NF-e enquanto 1 (remover após T5 do runbook).
# CATALOG_R1_DEPLOY=1

# Senha para usuários criados via seed-dev-users.mjs (use valor forte; nunca commite)
# SEED_DEV_PASSWORD=COLE_UMA_SENHA_FORTE
# SEED_GERENTE_EMAIL=e2e-gerente@localhost.test
# SEED_OPERADOR_EMAIL=e2e-operador@localhost.test
