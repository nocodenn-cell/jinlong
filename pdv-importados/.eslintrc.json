{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "@typescript-eslint/no-unused-vars": "error",
    "@typescript-eslint/no-explicit-any": "warn",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "excludedFiles": ["app/caixa/server/**/*", "app/caixa/actions.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/app/caixa/actions",
                "importNames": [
                  "AbrirCaixaOperadorResult",
                  "AcaoMovimentacaoCaixaResult",
                  "AutorizarMovimentacaoGerenteResult",
                  "BuscarProdutoResult",
                  "CancelarVendaResult",
                  "CarregarRegrasResult",
                  "CaixaStatusOperadorResult",
                  "FecharCaixaOperadorResult",
                  "FinalizarVendaCaixaResult",
                  "FormaMovimentacaoCaixa",
                  "LimiteSangriaResult",
                  "MovimentacaoCaixaDTO",
                  "ObterMovimentacoesCaixaResult",
                  "ProdutoCaixaDTO",
                  "RegistrarMovimentacaoInput",
                  "RegistrarMovimentacaoResult",
                  "StatusMovimentacaoCaixa",
                  "TipoMovimentacaoCaixa",
                  "ValidarGerenteDescontoResult"
                ],
                "message": "Tipos do caixa devem vir de '@/app/caixa/caixaActionTypes', '@/app/caixa/caixaOperadorTypes' ou '@/app/caixa/caixaMovimentacaoTypes'. Use '@/app/caixa/actions' apenas para as server actions (funções)."
              }
            ],
            "patterns": [
              {
                "group": ["@/app/caixa/server/*", "@/app/caixa/server/**"],
                "message": "Importe via '@/app/caixa/actions' (actions) ou via arquivos de tipos em '@/app/caixa/*Types'. Evite importar módulos server/* fora do boundary."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "app/caixa/**/*.{ts,tsx}",
        "app/gerente/**/*.{ts,tsx}",
        "components/caixa/**/*.{ts,tsx}",
        "components/gerente/**/*.{ts,tsx}"
      ],
      "excludedFiles": [
        "app/admin/**",
        "app/error.tsx",
        "app/caixa/error.tsx",
        "app/global-error.tsx",
        "**/page-old.tsx",
        "**/scan-pipeline/CaixaScanPipelineDevPanel.tsx",
        "**/ProdutosListaImpressao.tsx"
      ],
      "rules": {
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "JSXAttribute[name.name='className'][value.type='Literal'][value.value=/\\btext-gray-[3-9]/]",
            "message": "Dragon UI: use text-jl-fg-3 (≈gray-400) ou text-jl-fg-2 (≈gray-300). Ver docs/design-system/tokens.md"
          },
          {
            "selector": "JSXAttribute[name.name='className'][value.type='Literal'][value.value=/\\btext-slate-[3-9]/]",
            "message": "Dragon UI: use text-jl-fg-3 (≈slate-400) ou text-jl-fg-2 (≈slate-300). Ver docs/design-system/tokens.md"
          },
          {
            "selector": "JSXAttribute[name.name='className'][value.type='Literal'][value.value=/\\btext-zinc-[3-9]/]",
            "message": "Dragon UI: use text-jl-fg-3 (≈zinc-400) ou text-jl-fg-2 (≈zinc-300). Ver docs/design-system/tokens.md"
          },
          {
            "selector": "JSXAttribute[name.name='className'][value.type='Literal'][value.value=/\\bbg-slate-[89]/]",
            "message": "Dragon UI: use bg-jl-surface-elev ou bg-jl-surface-base. Ver docs/design-system/tokens.md"
          },
          {
            "selector": "JSXAttribute[name.name='className'][value.type='Literal'][value.value=/\\bbg-gray-[89]/]",
            "message": "Dragon UI: use bg-jl-surface-elev ou bg-jl-surface-base. Ver docs/design-system/tokens.md"
          },
          {
            "selector": "JSXAttribute[name.name='className'][value.type='Literal'][value.value=/\\bborder-slate-[4-9]/]",
            "message": "Dragon UI: use border-jl-border-1. Ver docs/design-system/tokens.md"
          },
          {
            "selector": "JSXAttribute[name.name='className'][value.type='Literal'][value.value=/\\bborder-gray-[4-9]/]",
            "message": "Dragon UI: use border-jl-border-1. Ver docs/design-system/tokens.md"
          }
        ]
      }
    },
    {
      "files": ["**/logger.ts", "**/logger/*.ts", "shared/logger.ts", "shared/unified-logger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/test/**/*.ts", "**/*.test.tsx", "**/*.spec.tsx"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/node_modules/**", "**/dist/**", "**/.next/**", "**/build/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
