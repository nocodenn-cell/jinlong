{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    // Prefixo `_` = intencionalmente não usado (ex.: `_ativo` em
    // resolveStatusPublicacaoLeitura, mantido para preservar a assinatura dos
    // call sites). A config anterior não honrava a convenção já usada no código.
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "prefer-const": "error",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/bg-(slate-900|gray-900|black)(?![\\/0-9])/]",
        "message": "Layout Compiler · Fase 0: fundo escuro proibido. O tema é único (claro, 'cara de Bling'). Use tokens: bg-[var(--surface)] / bg-jl-surface-base / bg-card. (Overlays translúcidos como bg-black/60 são permitidos.)"
      },
      {
        "selector": "Literal[value=/dark:/]",
        "message": "Layout Compiler · Fase 0: variante 'dark:' do Tailwind proibida. Não existe mais modo escuro — o tema é único (claro)."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      // fetchPdvStateSnapshot.internal.ts é infra server-side do PDV evaluation
      // (usa supabase/server; consumido só por runPdvEvaluation) — import
      // server→server legítimo, fora do alvo da regra (UI→server).
      "excludedFiles": [
        "app/caixa/server/**/*",
        "app/caixa/actions.ts",
        "lib/pdv/fetchPdvStateSnapshot.internal.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/app/caixa/actions",
                "importNames": [
                  "AbrirCaixaOperadorResult",
                  "AcaoMovimentacaoCaixaResult",
                  "AutorizarMovimentacaoGerenteResult",
                  "BuscarProdutoResult",
                  "CancelarVendaResult",
                  "CarregarRegrasResult",
                  "CaixaStatusOperadorResult",
                  "FecharCaixaOperadorResult",
                  "FinalizarVendaCaixaResult",
                  "FormaMovimentacaoCaixa",
                  "LimiteSangriaResult",
                  "MovimentacaoCaixaDTO",
                  "ObterMovimentacoesCaixaResult",
                  "ProdutoCaixaDTO",
                  "RegistrarMovimentacaoInput",
                  "RegistrarMovimentacaoResult",
                  "StatusMovimentacaoCaixa",
                  "TipoMovimentacaoCaixa",
                  "ValidarGerenteDescontoResult"
                ],
                "message": "Tipos do caixa devem vir de '@/app/caixa/caixaActionTypes', '@/app/caixa/caixaOperadorTypes' ou '@/app/caixa/caixaMovimentacaoTypes'. Use '@/app/caixa/actions' apenas para as server actions (funções)."
              }
            ],
            "patterns": [
              {
                "group": ["@/app/caixa/server/*", "@/app/caixa/server/**"],
                "message": "Importe via '@/app/caixa/actions' (actions) ou via arquivos de tipos em '@/app/caixa/*Types'. Evite importar módulos server/* fora do boundary."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/admin/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/app/admin/_components/AdminShell",
                "message": "Use AdminV2Shell de @/components/ui/admin-v2."
              },
              {
                "name": "@/app/admin/_components/AdminSidebar",
                "message": "Use SidebarNav de @/components/ui/admin-v2."
              },
              {
                "name": "@/components/ui/StatCard",
                "message": "Use MetricCard de @/components/ui/admin-v2."
              },
              {
                "name": "@/legacy/admin/AdminShell",
                "message": "Shell legado — proibido em app/admin."
              },
              {
                "name": "@/legacy/admin/AdminSidebar",
                "message": "Sidebar legado — proibido em app/admin."
              }
            ],
            "patterns": [
              {
                "group": ["**/legacy/admin/**", "@/legacy/admin/**"],
                "message": "Legacy admin UI — use @/components/ui/admin-v2."
              }
            ]
          }
        ]
      }
    },
    // Login/legal são páginas cerimoniais pré-auth (preto+ouro) — exceção deliberada
    // e auditada ao tema claro. Fora do escopo dos PageTypes operacionais do Layout
    // Compiler. (Nota: "comment" como propriedade é rejeitado pelo schema do ESLint
    // e quebrava `npm run lint` inteiro — comentários JSONC como este são suportados.)
    {
      "files": ["app/login/**/*.{ts,tsx}", "components/legal/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["**/logger.ts", "**/logger/*.ts", "shared/logger.ts", "shared/unified-logger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/test/**/*.ts", "**/*.test.tsx", "**/*.spec.tsx"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/node_modules/**", "**/dist/**", "**/.next/**", "**/build/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}