{
  "name": "fastproduct",
  "private": true,
  "description": "Monorepo PDV \u2014 workspaces: pdv-importados (Next), pdv-local (Tauri), backend (Supabase)",
  "workspaces": [
    "pdv-importados",
    "pdv-local",
    "backend",
    "shared-core",
    "site"
  ],
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=pdv-importados",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run check --filter=fastproduct-backend",
    "check:edge": "npm run check",
    "check:all": "turbo run check lint typecheck test",
    "ci": "turbo run check lint typecheck test && turbo run build --filter=pdv-importados",
    "dev:web": "npm run dev -w pdv-importados",
    "dev:desktop": "npm run dev -w pdv-local",
    "dev:tauri": "npm run tauri -w pdv-local",
    "validate:production": "node scripts/validate-production.mjs",
    "stress:pdv": "tsx dev-tools/pdv-stress-test.ts",
    "stress:pdv:check": "tsx dev-tools/pdv-consistency-check.ts",
    "gate:pdv": "tsx dev-tools/pdv-production-gate-simulator.ts",
    "gate:pdv:hybrid": "tsx dev-tools/pdv-production-gate-simulator.ts -- --mode=hybrid",
    "gate:pdv:full": "tsx dev-tools/pdv-production-gate-simulator.ts -- --mode=full",
    "test:e2e:critical": "npm run test:e2e:critical -w pdv-importados",
    "check:vendabilidade": "node scripts/check-vendabilidade-invariant.mjs",
    "check:routes": "node scripts/check-routes-invariant.mjs",
    "guard:core": "node scripts/core-rule-guard.mjs",
    "guard:pdv": "node scripts/pdv-flow-guard.mjs",
    "guard:routes": "node scripts/route-guard.mjs",
    "guard:rpc": "node scripts/rpc-gate-guard.mjs",
    "guard:pricing": "node scripts/pricing-rpc-guard.mjs",
    "guard:deps": "node scripts/dep-version-guard.mjs",
    "guard:migrations": "node scripts/migration-sequence-guard.mjs",
    "guard:domain": "node scripts/domain-boundary-guard.mjs",
    "guard:ratchet": "node scripts/boundary-ratchet-guard.mjs",
    "guard:ratchet:test": "node --test scripts/boundary-ratchet-guard.test.mjs",
    "guard:no-prod-target": "node scripts/no-prod-target-guard.mjs",
    "guard:capacity-target": "node --test scripts/capacity-target-guard.test.mjs",
    "capacity:assert-target": "npm run capacity:assert-target -w pdv-importados",
    "capacity:seed": "npm run capacity:seed -w pdv-importados",
    "capacity:reset": "npm run capacity:reset -w pdv-importados",
    "guard:all": "npm run guard:core && npm run guard:pdv && npm run guard:routes && npm run guard:rpc && npm run guard:pricing && npm run guard:deps && npm run guard:migrations && npm run guard:domain && npm run guard:ratchet && npm run guard:ratchet:test && npm run guard:no-prod-target && npm run guard:capacity-target && npm run check:entity-ssot -w pdv-importados",
    "pre-deploy:check": "bash scripts/pre-deploy-checklist.sh",
    "dev:site": "npm run dev -w jinlong-site",
    "build:site": "turbo run build --filter=jinlong-site",
    "test:site": "npm run test -w jinlong-site",
    "capacity:matrix": "node scripts/capacity/build-migration-matrix.mjs",
    "capacity:normalize-dry-run": "node scripts/capacity/dry-run-history-normalize.mjs"
  },
  "overrides": {
    "vitest": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@supabase/supabase-js": "^2.110.5",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "vitest": "^3.2.6"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@sentry/nextjs": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "@sentry/react": "^10.65.0",
    "@sentry/react-native": "^8.18.0",
    "@sentry/tracing": "^7.120.4",
    "@supabase/server": "^1.4.0",
    "@supabase/ssr": "^0.12.3",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tmp": "^0.2.7",
    "ws": "^8.21.3"
  }
}
