# ============================================
# FastProduct - Variáveis de Ambiente
# ============================================

# ---------- Supabase (obrigatório) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- URLs do Sistema ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Produção: https://fastproduct.naturecode.com.br

# ---------- Fiscal Worker (opcional, futuro) ----------
FISCAL_PROVIDER_TYPE=mock
# mock | http | focus | bling
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_TOKEN=
# Timeout HTTP/Focus (ms). Sugestão Focus: 30000
FISCAL_PROVIDER_TIMEOUT_MS=10000
FISCAL_ENVIRONMENT=homologacao
# Com FISCAL_PROVIDER_TYPE=focus: ref na query (documento_id | venda_id)
FISCAL_FOCUS_REF_FIELD=documento_id

# ---------- Sync-Outbox CORS (Edge Function) ----------
# Em produção, defina SYNC_OUTBOX_CORS_STRICT=true e liste as origens permitidas.
# Sem lista + STRICT, qualquer requisição com Origin é bloqueada.
# Sem STRICT e sem lista: Access-Control-Allow-Origin: * (apenas dev/homolog).
# SYNC_OUTBOX_CORS_STRICT=true
# SYNC_OUTBOX_ALLOWED_ORIGINS=https://SEU-DOMINIO.vercel.app,http://localhost:3000

# ---------- Enfileiramento Fiscal (desktop) ----------
AUTO_ENQUEUE_FISCAL_ON_SYNCED_SALE=false
FISCAL_DEFAULT_DOC_TYPE=NFC_E_STUB

# ---------- Sentry (opcional) ----------
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_DSN=
# SENTRY_RELEASE=auto-generated