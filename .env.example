# ============================================
# FastProduct - Variáveis de Ambiente
# ============================================

# ---------- Supabase (obrigatório) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------- Database (opcional, usado por ORM/scripts) ----------
# Usado apenas em backend/ORM (Prisma, migrations). Não expor no frontend.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DB_HOST:5432/postgres

# ---------- URLs do Sistema ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Produção: https://YOUR_PRODUCTION_URL.com

# ---------- Fiscal Worker (opcional, futuro) ----------
FISCAL_PROVIDER_TYPE=mock
# mock | http | focus | bling
FISCAL_PROVIDER_URL=YOUR_FISCAL_URL
FISCAL_PROVIDER_TOKEN=YOUR_FISCAL_TOKEN
# Timeout HTTP/Focus (ms). Sugestão Focus: 30000
FISCAL_PROVIDER_TIMEOUT_MS=10000
FISCAL_ENVIRONMENT=homologacao
# Com FISCAL_PROVIDER_TYPE=focus: ref na query (documento_id | venda_id)
FISCAL_FOCUS_REF_FIELD=documento_id

# ---------- Enfileiramento Fiscal (desktop) ----------
AUTO_ENQUEUE_FISCAL_ON_SYNCED_SALE=false
FISCAL_DEFAULT_DOC_TYPE=NFC_E_STUB

# ---------- Flags de Vendas ----------
USE_UNIFIED_SALES_FLOW=true
STRICT_MANAGER_DISCOUNT_AUTH=true

# ---------- Sessão ----------
NEXT_PUBLIC_IDLE_LOGOUT_MINUTES=0

# ---------- Sentry (opcional) ----------
# ATENÇÃO: O código espera os nomes EXATOS abaixo.
# SENTRY_RELEASE NÃO é usado - a release vem de VERCEL_GIT_COMMIT_SHA.
# Configure as 3 variáveis na Vercel (Production). Sem elas, o Sentry fica desligado.
#
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o4511246803664896.ingest.us.sentry.io/<project_id>
# SENTRY_ORG=YOUR_ORG
# SENTRY_PROJECT=YOUR_PROJECT