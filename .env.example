# ============================================
# FastProduct - Variáveis de Ambiente
# ============================================

# ---------- Supabase (obrigatório) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- URLs do Sistema ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Produção: https://fastproduct.naturecode.com.br

# ---------- Fiscal Worker (opcional, futuro) ----------
FISCAL_PROVIDER_TYPE=mock
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_TOKEN=
FISCAL_ENVIRONMENT=homologacao

# ---------- Enfileiramento Fiscal (desktop) ----------
AUTO_ENQUEUE_FISCAL_ON_SYNCED_SALE=false
FISCAL_DEFAULT_DOC_TYPE=NFC_E_STUB

