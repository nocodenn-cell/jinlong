{
  "name": "jinlong-site",
  "version": "0.1.0",
  "private": true,
  "description": "Site comercial bilíngue Jinlong (pt-BR / zh-CN). Independente do ERP: sem Supabase, sem credenciais.",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "node ../pdv-importados/node_modules/eslint/bin/eslint.js --resolve-plugins-relative-to ../pdv-importados --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fonts:subset": "tsx scripts/cjk-chars.ts && python -I scripts/subset_cjk_font.py"
  },
  "dependencies": {
    "next": "15.5.15",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.0.2",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
