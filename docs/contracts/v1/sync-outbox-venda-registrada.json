{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sync outbox VENDA_REGISTRADA v1",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tipo", "payload_json", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "tipo": { "const": "VENDA_REGISTRADA" },
          "payload_json": { "type": "string", "minLength": 2 },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-auth-headers": [
    "X-SYNC-KEY",
    "X-SYNC-TS",
    "X-SYNC-NONCE",
    "X-SYNC-SIGNATURE",
    "x-device-fingerprint"
  ]
}
