{
  "extends": "./tsconfig.json",
  "include": [
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/stores/**/*.ts",
    "src/stores/**/*.tsx",
    "src/catalogoLookup.ts",
    "src/config/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/App.tsx",
    "src/main.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
