{
  "name": "pdv-local",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "description": "PDV desktop local-first (Tauri + React) para loja de importados",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri dev",
    "env:check": "node scripts/check-env.mjs",
    "smoke:sync-edge": "node scripts/smoke-sync-edge.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastproduct/shared-core": "0.1.0",
    "@sentry/browser": "^11.8.0",
    "@supabase/supabase-js": "^2.104.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^29.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.3.4",
    "vitest": "^3.2.6"
  }
}
