# ============================================
# FastProduct - Variáveis de Ambiente (PDV Local)
# ============================================

# ---------- Supabase Sync ----------
SYNC_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/sync-outbox
SYNC_KEY=YOUR_SYNC_KEY

# ---------- Identificador do dispositivo (opcional, recomendado) ----------
# Exemplo: loja-01-caixa-02
DEVICE_FINGERPRINT=YOUR_DEVICE_FINGERPRINT

# ---------- Configuração de falhas ----------
# Após N falhas consecutivas, o item vai para DLQ (status ERRO).
OUTBOX_MAX_SYNC_FAILURES=12

# ---------- Catálogo e Configuração ----------
# O catálogo e o pdv_config são sincronizados pela Edge Function usando o header X-SYNC-KEY
# Isso evita armazenar service_role no desktop

# ---------- Futuro (não usado ainda) ----------
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------- Operador (opcional) ----------
PDV_OPERADOR_ID=YOUR_USER_UUID
