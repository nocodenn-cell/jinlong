# Use a service role key para evitar RLS/anon durante o MVP.
# Futuramente, podemos trocar por uma Edge Function com API key própria.
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI

# Opcional: UUID de public.usuarios (operador) para gravar nas vendas/caixas na nuvem
