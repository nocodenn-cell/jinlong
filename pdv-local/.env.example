SYNC_ENDPOINT=https://SEU-REF.supabase.co/functions/v1/sync-outbox

SYNC_KEY=defina_um_segredo_forte_nao_commite

# Opcional: após N falhas consecutivas retornadas pela Edge por evento, o item vai para DLQ (status ERRO).
# Padrão: 12. Falhas antes disso permanecem PENDENTE com backoff exponencial.
# OUTBOX_MAX_SYNC_FAILURES=12

# Para o PDV local carregar produtos e regras via Supabase REST
# (cache local-first; em caso de falha, o PDV continua offline com o cache atual)
SUPABASE_URL=https://SEU-REF.supabase.co
# Dashboard → Settings → API → service_role (NUNCA commite valor real; use só .env local).
# Hoje o sync de catálogo/pdv_config usa este papel (bypass RLS). Trate como segredo de infraestrutura
# na máquina da loja. Plano: JWT do operador ou RPC/Edge dedicada — ver docs/AMBIENTES_E_RELEASE.md
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SUA_SERVICE_ROLE_KEY

# Futuro (não usado pelo código ainda): anon pública; só faz sentido com RLS/RPC alinhados ao PDV.
# SUPABASE_ANON_KEY=

# Opcional: UUID de public.usuarios (operador) para gravar nas vendas/caixas na nuvem
# quando o app ainda não tem tela de login. Ex.: copie o id do usuário no Supabase.
# PDV_OPERADOR_ID=
