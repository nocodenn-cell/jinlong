{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jinlong PDV",
  "version": "0.1.0",
  "identifier": "com.fastproduct.pdv.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PDV Local - Caixa",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Jinlong",
    "shortDescription": "PDV desktop offline do Jinlong",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
